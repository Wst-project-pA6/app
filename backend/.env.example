# WST Backend Environment Configuration
# Copy this file to .env and fill in your actual values
# Never commit .env to version control

# Application
NODE_ENV=development
PORT=3000
# Public base URL used to build attachment download links. Must be https in production;
# http is only accepted for localhost/127.0.0.1/[::1] outside production.
APP_BASE_URL=http://localhost:3000

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=DataBase_WorkShop_Management
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_SSL=false

# Authentication (generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))")
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=wst-api
AUTH_JWT_AUDIENCE=wst-client

# Attachments
ATTACHMENTS_STORAGE_DIR=storage/attachments
# Signs short-lived attachment download links. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# If left empty, falls back to AUTH_JWT_SECRET (never to a hardcoded value). If set, must be
# at least 32 bytes, same as AUTH_JWT_SECRET.
ATTACHMENTS_SIGNING_SECRET=

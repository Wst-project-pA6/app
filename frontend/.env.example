# Base URL for API requests.
#
# Development: leave unset (or point at "/api/v1") so requests go through the
# Vite dev server proxy defined in vite.config.ts, which forwards /api to
# http://localhost:3000. This avoids needing backend CORS configuration for
# local development.
#
# Production: set to the fully-qualified API base URL of the deployed backend,
# for example https://wst.example.edu/api/v1
VITE_API_BASE_URL=/api/v1
